{
  "$schema": "../../layer.schema.json",
  "label": "shadcn/ui",
  "hint": "copy-in Radix + Tailwind components (requires Tailwind)",
  "requires": {
    "styling": [
      "tailwind"
    ]
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0"
  },
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@4.22.1",
        "mcp"
      ],
      "pin": "shadcn@4.22.1"
    }
  },
  "steering": [
    {
      "target": "structure.md",
      "section": "ui",
      "content": "## UI (shadcn/ui)\n\n- Generated components in `src/components/ui/` (owned by this project, edit freely); `cn()` in `src/lib/utils.ts`; `components.json` configures the shadcn CLI."
    }
  ],
  "variants": [
    {
      "name": "app",
      "when": {
        "type": "app"
      },
      "overrides": [
        "src/index.css"
      ]
    },
    {
      "name": "library",
      "when": {
        "type": "library"
      },
      "overrides": [
        "src/styles.css"
      ],
      "patches": [
        {
          "file": "src/index.ts",
          "anchor": "index-exports",
          "content": "export { Button as UiButton, buttonVariants } from \"./components/ui/button\";\nexport { cn } from \"./lib/utils\";"
        }
      ]
    }
  ]
}
